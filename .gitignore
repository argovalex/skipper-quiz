.venv-crewai/
node_modules/
.env

# תוצרי crew: מקומיים, לא נכסים
crew/backups/
crew/reports/
crew/proposals.jsonl
__pycache__/

# publisher: ריפו נפרד (skipper-quiz-publisher), לא סאב-מודול
publisher/

# html/: 355 קבצים מיוצרים ע"י src/generate-all-l11.js + generate-compass-reel.js
html/

# scratch: סקריפטים ותוצרים חד-פעמיים, לא נכסים
scratch_*

# caches ותוצרי build/עיבוד מקומיים
graphify-out/
.tilecache/
.review-data.json
quiz_videos/
media/preview/
chk.mp3

# ארכיון מקומי (סקריפטים ישנים)
_archive/

# וידאו: תוצרים כבדים, נשמרים מקומית/OneDrive לא ב-git (הטקסט והאיורים של lessons/ כן נעקבים)
*.mp4
video course/

# חריג: media/bgclips/ הם קלטי-מקור (רקעי סצנה) שהשרת מושך מ-GitHub, לא תוצרי רינדור
!media/bgclips/
!media/bgclips/*.mp4

# חריג זמני: media/videos/ הוא פתרון-ביניים לאירוח סרטונים סופיים דרך git-raw
# בזמן ששרת הרינדור (Railway→Cloudinary) תקוע. לא לשימוש קבוע, רק לשאלה בודדת בכל פעם.
!media/videos/
!media/videos/*.mp4

# YouTube OAuth: סודות מקומיים, לעולם לא ב-git
tools/youtube/client_secret.json
tools/youtube/token.json

# inputs מקוריים וניסויים מקומיים
*.pdf
*.xlsx
FB profile.jpg
723085307_*.jpg
questions-Alex.json
raspen_5_diverse.json
references/*.patch
