# Copy to .env for local dev. On Railway these are set as service variables.
# NEVER commit real secrets. .env is gitignored.

PORT=8080

# Postgres. Empty = DB endpoints (codes/progress/coupons/notify) return 503,
# but /health, /api/free and /api/content (with DEV_ACCESS_CODE) still work.
DATABASE_URL=

# Question source of truth. Local file used first for dev if present.
# For launch this MUST point to a PRIVATE source, not the public repo (see README security note).
DATA_URL=https://raw.githubusercontent.com/argovalex/skipper-quiz/main/data/l11.json
FORCE_REMOTE=

# CORS origin for the PWA. Set to the Pages/app origin at launch.
ALLOWED_ORIGINS=*

# Dev master code so you can test paid content without a DB. Remove in prod.
DEV_ACCESS_CODE=DEV-OPEN

# Admin token for POST /api/admin/reload (refresh content without redeploy).
ADMIN_TOKEN=

# Shared secret Tranzila echoes back on notify, to reject forged callbacks.
TRANZILA_NOTIFY_SECRET=

# Tranzila terminal (supplier) name. EMPTY = simulated checkout page (dev).
# Set it to switch to the real Tranzila hosted page + disable the /api/dev/* simulator.
TRANZILA_TERMINAL=

# Public base URL of THIS api (for building return links). Empty = derived from request.
PUBLIC_URL=

# Real code email (nodemailer). Empty = simulation (logs the code).
SMTP_URL=

# Real invoicing (Morning / Green Invoice). Empty = simulation (logs the invoice).
INVOICE_API_KEY=

# Price shown / charged (ILS). Editable at runtime via admin.js; this is the seed default.
PRICE_ILS=99
